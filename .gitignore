# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.claude/
.codegraph/
.wolf/

# IDE
# .vscode is developer-local by default. Only .vscode/workspaces/*.code-workspace
# is a tracked project artifact - to track another .vscode path, add an explicit
# negation for it the same way, rather than un-ignoring .vscode/ wholesale.
.vscode/*
!.vscode/workspaces/
.vscode/workspaces/*
!.vscode/workspaces/*.code-workspace

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
