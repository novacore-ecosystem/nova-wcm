# Gateway origin only — each backend service supplies its own path prefix.
NEXT_PUBLIC_API_BASE_URL=

# nova-wcm's TenantClient public key (X-Tenant-Client-Key on /auth/login). Identifies which
# tenant/client is logging in — not a per-user secret. Ask the Auth service owner for the
# seeded TenantClient key for the nova-wcm application in your environment. Until this is
# provisioned, login against the real Auth service will fail with an unresolved-tenant error;
# every other module in this app is mocked and works without it.
NEXT_PUBLIC_TENANT_CLIENT_KEY=
